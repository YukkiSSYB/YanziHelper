# Publish only reviewed source files. Local binaries, profiles, analysis materials,
# private settings, caches and build output stay outside version control.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE.md
!/SOURCE_PROVENANCE.json
!/config.example.ini
!/requirements-dev.txt
!/build_release.ps1
!/YanziHelper.release.spec
!/使用说明.txt
!/YanziHelper.py
!/app_config.py
!/app_selftest.py
!/dd_device.py
!/dd_lifecycle.py
!/foreground_guard.py
!/keyboard_hook.py
!/macro_engine.py
!/pydd.py
!/tests/
/tests/*
!/tests/test_app_config.py
!/tests/test_app_ui.py
!/tests/test_dd_device.py
!/tests/test_dd_lifecycle.py
!/tests/test_foreground_guard.py
!/tests/test_keyboard_hook.py
!/tests/test_macro_engine.py
!/tests/test_pydd.py
!/tests/test_release.py
!/tools/
/tools/*
!/tools/package_release.py
!/tools/driver_kit/
/tools/driver_kit/*
!/tools/driver_kit/Launcher.cs
!/tools/driver_kit/TestLauncher.cs
!/tools/driver_kit/launcher.manifest
!/tools/driver_kit/build_launcher.ps1
!/docs/
/docs/*
!/docs/PROVENANCE.md
!/docs/SOURCE_PROVENANCE-2026-11-15.json
!/docs/DD-LICENSE.md
!/docs/windows-tests.yml.example
!/LICENSES/
/LICENSES/*
!/LICENSES/pydd-MIT.txt
